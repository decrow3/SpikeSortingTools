**/__pycache__/
.uv-python/
.venv-aind/
environments/*/.venv/
pipeline_results
pipeline_results*

# Generated diagnostic runs, arrays, figures, reports, and notebooks.
# Curated evidence can still be added explicitly with `git add -f`.
testing/outputs/

# Generated repository collations / code bundles (see collate_files.py).
repo_collation.txt
code_bundle.md

# Batch and resume run logs. Curated logs can be added with `git add -f`.
*.log

# Active run configuration is host state; the tracked template is
# configs/example.run.toml.
configs/run.toml
configs/run.*.toml

# Evaluation-ladder host state; tracked template is configs/example.ladder.toml.
configs/ladder.toml
