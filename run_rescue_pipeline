#!/usr/bin/env bash
set -euo pipefail

rescue_repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/spikesortingtools-uv-cache}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-${rescue_repo_dir}/.uv-python}"

exec uv run \
  --project "${rescue_repo_dir}/environments/rescue-production" \
  --frozen \
  --no-group test \
  python "${rescue_repo_dir}/SpikeGLX_ext_ref_rescue_testing.py" \
  "$@"
